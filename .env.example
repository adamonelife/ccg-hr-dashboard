# Existing People database/session/login configuration is unchanged.
# Both controls default OFF when absent. Never enable production from this file.
PEOPLE_STAFF_ACCESS_ENABLED=false
PEOPLE_PLATFORM_ENFORCEMENT_ENABLED=false

# Configure only in an explicitly approved QA environment initially.
# On Vercel, VERCEL_ENV pins the context environment automatically.
PEOPLE_STAFF_ACCESS_ENVIRONMENT=preview
PEOPLE_STAFF_ACCESS_ORGANISATION_ID=
PEOPLE_STAFF_ACCESS_ORIGIN=
PEOPLE_STAFF_ACCESS_ISSUER_ORIGIN=
PEOPLE_STAFF_ACCESS_COHORT_IDS=
# Independent random 32-byte base64 key; server only.
PEOPLE_CONTEXT_ENCRYPTION_KEY=
# Independent shared server-only secret, at least 32 characters.
PEOPLE_BROKER_SECRET=
PEOPLE_PLATFORM_URL=
PEOPLE_PLATFORM_PUBLISHABLE_KEY=
# Companion Staff Access deployment uses the same broker secret and its own flag:
# NALLIN_PEOPLE_URL=<approved People origin>
